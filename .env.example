# ==============================================================================
# Proxmox VE Automation & Lab Helper Scripts Configuration Template
# Copy this file to .env and adjust values for your environment.
#
# IMPORTANT:
# 1. Never commit your real '.env' file to a public git repository!
# 2. .env is listed in .gitignore by default.
# 3. In Proxmox clusters, you can also place this file at:
#    /etc/pve/scripts/.env or /etc/pve/secrets/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Proxmox Backup Server (PBS) Configuration
# ------------------------------------------------------------------------------
# PBS repository in format: USER@REALM!TOKEN_NAME@HOST:DATASTORE
PBS_REPOSITORY="BACKUPER@pbs!host@pbs.example.com:Datastore"

# Secret API Token or user password for PBS authentication
PBS_PASSWORD="your-pbs-api-token-secret-uuid"

# PBS TLS Certificate Fingerprint (run 'proxmox-backup-manager cert info' on PBS)
PBS_FINGERPRINT="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"

# Path to the Proxmox client encryption key (optional, for client-side encryption)
PBS_KEYFILE="/etc/pve/priv/storage/your-pbs-storage.enc"

# Target PBS namespace
PBS_NAMESPACE="BareMetal"

# Log file for backup execution
PBS_LOG_FILE="/var/log/proxmox_host_backup.log"

# Optional additional exclude patterns for PBS backup (space-separated)
# PBS_EXTRA_EXCLUDES="/var/log/** /opt/scratch/**"

# ------------------------------------------------------------------------------
# 2. LXC Container Provisioning & Auto-Provision Watcher
# ------------------------------------------------------------------------------
# Default administrative username created in containers (replaces direct root SSH)
LXC_DEFAULT_USER="hubi"

# Default password for the administrative user (leave empty to prompt interactively / auto-generate)
# LXC_USER_PASSWORD=""

# Central cluster password registry file (stores randomly generated root passwords)
HASLA_FILE="/etc/pve/secrets/.hasla"

# Local DNS search domain configured inside containers
SEARCH_DOMAIN="example.internal"

# Host path to authorized SSH public keys to copy into user's ~/.ssh/authorized_keys
SSH_PUBKEY_PATH="/root/.ssh/authorized_keys"

# LXC Auto-Provision Watcher settings (system-config/lxc-auto-provision.service)
WATCHER_POLL_INTERVAL="10"
WATCHER_LOG_FILE="/var/log/lxc-auto-provision.log"
WATCHER_FAIL_COOLDOWN="300"

# ------------------------------------------------------------------------------
# 3. Wazuh Agent Deployment for Onboarded Containers
# ------------------------------------------------------------------------------
# FQDN or IP of the Wazuh Manager server
WAZUH_MANAGER="wazuh.example.com"

# Registration group for new agents
WAZUH_AGENT_GROUP="linux-servers"

# Version of the Debian/Ubuntu wazuh-agent package
WAZUH_AGENT_VERSION="4.14.7-1"

# Target version for Wazuh Agent v5 upgrade suite (update_wazuh_agent_v5.sh)
WAZUH_AGENT_V5_VERSION="5.0.0-beta5"

# ------------------------------------------------------------------------------
# 3b. Zabbix Agent Deployment for Containers, VMs & Hosts
# ------------------------------------------------------------------------------
# Enable Zabbix Agent 2 installation during provisioning (true/false)
ZABBIX_AGENT_ENABLE="true"

# Zabbix Server or Proxy address (passive checks)
ZABBIX_SERVER="zabbix.example.com"

# Zabbix Server or Proxy address for active agent checks
ZABBIX_SERVER_ACTIVE="zabbix.example.com"

# ------------------------------------------------------------------------------
# 4. Proxmox Storage Pools & Hypervisor Network Defaults
# ------------------------------------------------------------------------------
# Storage pool for VM and LXC disks (e.g., local-lvm, local-zfs, zfs-pool)
DEFAULT_STORAGE="local-lvm"

# Storage pool for ISOs and LXC templates (e.g., local)
TEMPLATE_STORAGE="local"

# Default Network Bridge for Containers (ProxNET is intended for backend servers behind Nginx Reverse Proxy)
MGMT_BRIDGE="ProxNET"

# Automatically freeze dynamic DHCP/SLAAC leases into permanent STATIC IP configuration
FREEZE_NETWORK_STATIC="true"

# Dedicated isolated measurement bridges for TRex / DUT network benchmarking
WAN_BRIDGE="vmbr10"
LAN_BRIDGE="vmbr20"

# ------------------------------------------------------------------------------
# 5. Cisco TRex Traffic Generator VM Settings
# ------------------------------------------------------------------------------
TREX_VMID=""
TREX_HOSTNAME="trex-generator-node"
TREX_CORES="8"
TREX_RAM_MB="8192"
TREX_DISK_SIZE="32G"
TREX_CI_USER="trex"
TREX_CI_PASSWORD="ChangeMeSecurely123!"

# ------------------------------------------------------------------------------
# 6. Router Device Under Test (DUT) VM Settings
# ------------------------------------------------------------------------------
DUT_VMID=""
DUT_TYPE="vyos"             # vyos | openwrt | mikrotik | debian
DUT_HOSTNAME="dut-router-node"
DUT_CORES="4"
DUT_RAM_MB="4096"

# ------------------------------------------------------------------------------
# 7. SNMP & Syslog Telemetry Collector LXC Settings
# ------------------------------------------------------------------------------
SNMP_CTID=""
SNMP_HOSTNAME="snmp-telemetry-collector"
SNMP_CORES="2"
SNMP_RAM_MB="2048"
SNMP_COMMUNITY="lab_telemetry"

# ------------------------------------------------------------------------------
# 8. ProjectDiscovery Nuclei Scanner LXC Settings
# ------------------------------------------------------------------------------
NUCLEI_CTID=""
NUCLEI_HOSTNAME="nuclei-vulnerability-scanner"
NUCLEI_CORES="2"
NUCLEI_RAM_MB="2048"

# ------------------------------------------------------------------------------
# 9. Wazuh 5 Beta LXC / Distributed Settings
# ------------------------------------------------------------------------------
WAZUH_CTID=""
WAZUH_HOSTNAME="wazuh5-server"
WAZUH_ADMIN_PASSWORD="ChangeMeWazuh5!"

# ------------------------------------------------------------------------------
# 10. Zabbix 8.0 LTS LXC Settings (Debian 13 Trixie + PostgreSQL 17)
# ------------------------------------------------------------------------------
ZABBIX_CTID=""
ZABBIX_HOSTNAME="zabbix8-server"
ZABBIX_CORES="2"
ZABBIX_RAM_MB="4096"
ZABBIX_SWAP_MB="1024"
ZABBIX_DISK_GB="16"
ZABBIX_DB_NAME="zabbix"
ZABBIX_DB_USER="zabbix"
# Leave empty to generate a random 16-byte hex password automatically
ZABBIX_DB_PASSWORD=""
ZABBIX_LOCAL_WEB_PORT="8080"

# ------------------------------------------------------------------------------
# 11. Proxmox Software Defined Network (SDN) Cluster Network
# ------------------------------------------------------------------------------
# SDN Zone name (VLAN-based SDN zone)
SDN_ZONE="ClusterZone"

# Underlying bridge for VLAN tagging
SDN_BRIDGE="ProxNET"

# SDN VNet ID (maximum 8 alphanumeric characters in Proxmox SDN)
SDN_VNET_ID="wazuhcl"

# SDN VNet human-readable alias / full network name
SDN_VNET_ALIAS="Wazuh-cluster-net"

# 802.1Q VLAN Tag (> 1500 for isolated cluster fabric)
CLUSTER_VLAN_TAG="1669"

# Cluster Subnet & Gateway (Address space: 10.69.101.0/24 to 10.69.250.0/24)
CLUSTER_SUBNET="10.69.101.0/24"
CLUSTER_GATEWAY="10.69.101.1"

# Wazuh Distributed Cluster Node IP assignments
INDEXER_CLUSTER_IP="10.69.101.10"
MANAGER_CLUSTER_IP="10.69.101.11"
DASHBOARD_CLUSTER_IP="10.69.101.12"

# ------------------------------------------------------------------------------
# 11. PVE Cluster Configuration & Metadata Backup (backup/pve-cluster-config-backup.sh)
# ------------------------------------------------------------------------------
# Passphrase used to symmetrically encrypt /etc/pve metadata backups (AES-256-CBC)
PVE_CONFIG_BACKUP_KEY="your-strong-backup-encryption-key-here"

# Directory to store local cluster configuration archives
PVE_CONFIG_BACKUP_DIR="/var/backups/pve-cluster"

# Number of daily backup archives to keep locally
PVE_CONFIG_BACKUP_KEEP="14"

# ------------------------------------------------------------------------------
# 12. Hypervisor Host Hardening & Stability Tuning (system-config/pve-host-hardening.sh)
# ------------------------------------------------------------------------------
# Maximum RAM allocated to ZFS ARC cache in MB (leave empty for auto 20% of RAM)
ZFS_ARC_MAX_MB="8192"

# Hardware watchdog module (auto | iTCO_wdt | sp5100_tco | ipmi_watchdog | softdog)
WATCHDOG_MODULE="auto"



