# ==============================================================================
# Proxmox VE Automation & Lab Helper Scripts Configuration Template
# Copy this file to .env and adjust values for your environment.
#
# IMPORTANT:
# 1. Never commit your real '.env' file to a public git repository!
# 2. .env is listed in .gitignore by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# Proxmox Storage Pools & Bridges
# ------------------------------------------------------------------------------
# Storage pool for VM and LXC disks (e.g., local-lvm, local-zfs, zfs-pool)
DEFAULT_STORAGE="local-lvm"

# Storage pool for ISOs and LXC templates (e.g., local)
TEMPLATE_STORAGE="local"

# Management Bridge (connected to your LAN/management network)
MGMT_BRIDGE="vmbr0"

# Dedicated isolated measurement bridges for TRex / DUT network benchmarking
WAN_BRIDGE="vmbr10"
LAN_BRIDGE="vmbr20"

# ------------------------------------------------------------------------------
# Cisco TRex Traffic Generator VM Settings
# ------------------------------------------------------------------------------
# VM ID (leave empty to automatically allocate next available cluster ID)
TREX_VMID=""
TREX_HOSTNAME="trex-generator-node"
TREX_CORES="8"
TREX_RAM_MB="8192"
TREX_DISK_SIZE="32G"

# Cloud-Init Credentials for TRex VM
TREX_CI_USER="trex"
TREX_CI_PASSWORD="ChangeMeSecurely123!"

# ------------------------------------------------------------------------------
# Router Device Under Test (DUT) VM Settings
# ------------------------------------------------------------------------------
# VM ID (leave empty to automatically allocate next available cluster ID)
DUT_VMID=""
# Router OS Type: vyos | openwrt | mikrotik | debian
DUT_TYPE="vyos"
DUT_HOSTNAME="dut-router-node"
DUT_CORES="4"
DUT_RAM_MB="4096"

# ------------------------------------------------------------------------------
# SNMP & Syslog Telemetry Collector LXC Settings
# ------------------------------------------------------------------------------
SNMP_CTID=""
SNMP_HOSTNAME="snmp-telemetry-collector"
SNMP_CORES="2"
SNMP_RAM_MB="2048"
SNMP_COMMUNITY="lab_telemetry"

# ------------------------------------------------------------------------------
# ProjectDiscovery Nuclei Scanner LXC Settings
# ------------------------------------------------------------------------------
NUCLEI_CTID=""
NUCLEI_HOSTNAME="nuclei-vulnerability-scanner"
NUCLEI_CORES="2"
NUCLEI_RAM_MB="2048"

# ------------------------------------------------------------------------------
# Wazuh 5 Beta LXC / Distributed Settings
# ------------------------------------------------------------------------------
WAZUH_CTID=""
WAZUH_HOSTNAME="wazuh5-server"
WAZUH_ADMIN_PASSWORD="ChangeMeWazuh5!"
